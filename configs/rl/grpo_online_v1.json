{
  "_comment": "Online GRPO over verified sibling groups. Root-level normalisation stays auditable: every sample carries root_id and group_id.",
  "schema": "lmm_rl_config_v1",
  "reward": {
    "success_weight": 1.0,
    "shaping_weights": {},
    "clip_low": null,
    "clip_high": null
  },
  "dataset": {
    "min_group_size": 2,
    "require_verified_backend": true,
